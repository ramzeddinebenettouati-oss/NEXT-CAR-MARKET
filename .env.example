# Copy to .env and fill in. In production set these in Render → Environment.

# ── Required ────────────────────────────────────────────────────────────────
# Supabase → Project → Connect → Session pooler. Keep the query string: it
# turns on SSL without failing on Supabase's certificate chain.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Local dev alternative:
# DATABASE_URL=postgresql://postgres@localhost:5432/autocango

PORT=8080
NODE_ENV=development

# Required when NODE_ENV=production (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Public URL used in e-mail links (password reset, notifications)
APP_URL=http://localhost:5173

# Super admin created on startup when the database has none. In production
# the password is required for this (no default); without it, seeding is
# skipped. In development it falls back to SuperAdmin123!. Change the password
# after first login; once an admin exists these are ignored.
INITIAL_ADMIN_EMAIL=admin@nextcarmarket.com
INITIAL_ADMIN_PASSWORD=

# ── File storage (any S3-compatible service) ───────────────────────────────
# Supabase → Storage → S3 Connection → endpoint + "New access key"
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Paths are /<bucket>/<prefix>. Create one *private* bucket (e.g. "autocango").
PRIVATE_OBJECT_DIR=/autocango/.private
PUBLIC_OBJECT_SEARCH_PATHS=/autocango/public
# S3_FORCE_PATH_STYLE=true

# Local disk for chat attachments and vehicle videos (Render: persistent disk)
# UPLOADS_DIR=/var/data/uploads

# ── Optional integrations ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LOG_LEVEL=info
